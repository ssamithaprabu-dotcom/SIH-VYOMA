# Copy this file to .env and fill in your own values

PORT=4000

# Used to sign login tokens - change this to any random long string
JWT_SECRET=change-this-to-a-long-random-string

# Default dashboard login (created automatically on first run)
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=vyoma@2026

# Shared key the ESP8266 must send in the X-Device-Key header when
# posting telemetry. Keep this the same on the firmware side.
DEVICE_KEY=vyoma-device-key

# Optional: if set, the onboard chatbot will use Claude to answer
# questions about the current flight. If left blank, the chatbot
# falls back to simple built-in answers (still fully functional).
ANTHROPIC_API_KEY=
