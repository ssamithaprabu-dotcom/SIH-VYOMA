# VYOMA AI Monitoring Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=10.0
LLM_KEEP_ALIVE=30m

# Vector Database & RAG Settings
KNOWLEDGE_BASE_PATH=knowledge
CHROMA_PERSIST_DIR=.chromadb
RAG_TOP_K=3

# Alert & Processing Settings
BACKGROUND_WORKER_QUEUE_SIZE=50
